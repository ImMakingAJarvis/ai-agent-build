# Copy to bootstrap.env (e.g. on network storage), fill in, then run:
#   ./bootstrap.sh /path/to/bootstrap.env
# Keep the real file private: it holds your API key and bot token.

ANTHROPIC_API_KEY=
GITHUB_APP_ID=
# Absolute path, or relative to this file's folder.
GITHUB_APP_KEY=thisappismakingajarvis.private-key.pem
REPO_URL=https://github.com/ImMakingAJarvis/ai-agent-build.git
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=196095241462349825

# Optional: mount this SMB share read-write at /mnt/jarvis for the agent.
#NAS_SHARE=//192.168.1.20/JarvissFolder
#NAS_USER=
#NAS_PASSWORD=

# Optional
#AGENT_STAGE1_MODEL=haiku
#AGENT_STAGE2_MODEL=sonnet

# Local job power cost: $/kWh for the electricity meter (0 = track kWh
# at $0). Plus a flat non-GPU system overhead in watts (the machine has
# no system power sensor; see docs/agent-jobs.md).
#JARVIS_POWER_RATE=0.15
#JARVIS_POWER_SYSTEM_W=
