# VRAM/RAM ledger + lease broker + swap-window controller (plan tasks
# EVB-25/EVB-27, docs/services.md).
#
# Host-side since EVB-27: the window controller shells out to jarvis-swap
# (docker, nvidia-smi, jarvis-watchdog) and reads the agent job store, so
# it runs here instead of as a compose container. The ledger and the
# window controller share the process (one binary, one /state, one
# /metrics).
#
# Listen on the docker bridge gateway, NOT 127.0.0.1: the capability
# containers reach it via host.docker.internal (extra_hosts
# host-gateway in docker-compose.yml), and 127.0.0.1 is not routable
# from a container. Binding 172.17.0.1 instead of 0.0.0.0 keeps the
# lease API off the LAN (the house network). If the bridge IP ever
# changes (docker daemon.json bip), this line must follow.
[Unit]
Description=Jarvis resourced (VRAM/RAM ledger, lease broker, swap-window controller)
After=network-online.target docker.service
Wants=network-online.target
# Easy inhibit: touch this file before reboot (undo: rm it).
ConditionPathExists=!/var/lib/jarvis/resourced.disabled

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/ai-agent-build
Environment=LISTEN_ADDR=172.17.0.1:9104
Environment=RABBITMQ_URL=amqp://jarvis:jarvis-local@localhost:5672
Environment=CAPABILITIES_FILE=/home/agent/ai-agent-build/config/capabilities.yaml
Environment=REFRESH_INTERVAL=30s
Environment=WINDOW_INTERVAL=30s
# Sunshine's video-stream UDP port (its config here is all-default).
Environment=SUNSHINE_STREAM_PORT=48010
# plan §7.2 defaults (no Nathan answer in the Discord logs, PR #231)
Environment=MAX_WINDOW=2h
Environment=MAX_BRAIN_WAIT=20m
Environment=MIN_WINDOW=2m
ExecStart=/usr/local/bin/resourced
# The window controller opens and closes real swap windows (brain out /
# brain in): come back after a crash, never park.
Restart=always
RestartSec=5
StandardOutput=append:/home/agent/.local/state/jarvis/resourced.log
StandardError=append:/home/agent/.local/state/jarvis/resourced.log
SyslogIdentifier=resourced

[Install]
WantedBy=multi-user.target
