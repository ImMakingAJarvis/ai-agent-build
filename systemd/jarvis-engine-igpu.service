[Unit]
Description=Jarvis iGPU Engine — Vulkan llama.cpp server on the Ryzen iGPU (auxiliary models)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
SupplementaryGroups=video render
PIDFile=/run/jarvis-engine-igpu.pid
# --host 0.0.0.0 so the stack's containers (voice, chat) can reach the
# helper model via host.docker.internal while the worker is deep in a job;
# the model carries no secrets, so LAN visibility is acceptable.
ExecStart=/opt/jarvis-igpu/bin/llama-server \
    -m /opt/jarvis-igpu/models/jarvis-igpu.gguf \
    --host 0.0.0.0 \
    --port 11435 \
    -dev Vulkan1 \
    -ngl 99 \
    --ctx-size 32768 \
    --jinja \
    --metrics \
    --log-disable
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-engine-igpu

[Install]
WantedBy=multi-user.target
