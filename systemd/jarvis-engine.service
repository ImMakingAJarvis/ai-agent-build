[Unit]
Description=Jarvis Brain Engine — llama.cpp server with work and chat slots
After=network-online.target
Wants=network-online.target
Conflicts=ollama.service

[Service]
Type=simple
User=agent
Group=agent
PIDFile=/run/jarvis-engine.pid
ExecStart=/opt/jarvis-engine/bin/llama-server \
    -m /opt/jarvis-engine/models/jarvis-brain.gguf \
    --port 11434 \
    --parallel 2 \
    --ctx-size 131072 \
    --kv-unified \
    --jinja \
    --chat-template-file /opt/jarvis-engine/templates/qwen3.8-chat-template.jinja \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --slot-save-path /var/lib/jarvis/slots \
    --log-disable
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-engine

[Install]
WantedBy=multi-user.target
