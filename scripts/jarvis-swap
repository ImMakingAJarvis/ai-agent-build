#!/usr/bin/env bash
# jarvis-swap — swap the Jarvis brain out of the 4090 for GPU capability
# work and back again. Runbook: docs/brain-swap.md. The brain holds
# ~17.6 GB of the 4090's 24.5 GB; needs_brain_out capability workers (the
# art/bench services) wait for 12 GB free before running, so such work
# cannot run while the brain is loaded.
#
# Since EVB-27 the window is driven by resourced — the VRAM/RAM ledger's
# window controller (plan §3.6, rules 3–4): it opens the window when
# queued GPU-needing capability work exists and no local (brain) round is
# running, and closes it when the capability queues drain (or at the
# max_window / max_brain_wait limits). The old agent-run photo bracket is
# gone: photo jobs are just image.generate work that runs as code (the
# jarvis-photo executor, no model round) inside the window, and resourced
# watches their cap queue like any other client.
#
# Failsafe: `out` opens a `jarvis-watchdog maintain` window. If anything in
# the window dies (a generation fails, the window never drains), the
# watchdog re-arms the brain at the deadline and says so on Discord — the
# brain is never stranded off.
#
# What this script touches:
#   brain   docker container jarvis-engine (compose service `engine`, serving
#           127.0.0.1:11434 and engine:11434 on the compose net; the same
#           container the watchdog restarts). `out` stops it, `in` starts it.
#   photos  compose services `art` (Z-Image-Turbo, 8120) and `bench`
#           (t2i bench, 8121).
#
# Commands:
#   jarvis-swap status                          one-screen state report
#   jarvis-swap out [--for CAPS] [--maintain 4h] [--jobs a,b] [--bump 1000]
#                 [--reason TEXT] [--job ID] [--force]
#       --for       comma-separated capabilities the window serves (recorded
#                   in the state file, shown by `status`; resourced passes
#                   the queued brain-out capabilities it saw when opening)
#       --maintain  watchdog window length (default 4h; 45s|30m|2h|seconds)
#       --jobs      comma-separated queued job ids to flip to the igpu
#                   driver (jarvis-jobs requeue -driver igpu -priority N <id>)
#       --bump      priority the flipped jobs get (default 1000): they must
#                   outrun every other job in their band during the window
#       --job       the swap job's own id (verifies it is the only round running)
#       --force     allow a run with NO round running (manual, or resourced's
#                   automated open). Never bypasses a running round —
#                   invariant 1: the brain never stops itself mid-round.
#   jarvis-swap in [--reason TEXT]
#   jarvis-swap handoff                         write notes/brain-handoff.md
#       scaffold (queue snapshot auto-filled; the brain fills in its context)
#   all take --dry-run.
#
# Log: ~/.local/state/jarvis/swap.log. State: swap-window.json next to it —
# the open window's for-list, reason and opened_at. Written early by `out`
# (before the long swap steps) and cleared by a successful `in`; resourced
# reads it to know the window is open. Idempotent re-runs: `out` while the
# window is open re-records the marker and re-flips jobs; `in` while the
# brain is up just closes the maintenance window and clears the marker.
set -u

REPO="${SWAP_REPO:-/home/agent/ai-agent-build}"
STATE="$HOME/.local/state/jarvis"
LOG="$STATE/swap.log"
WINDOW_STATE="${SWAP_WINDOW_STATE:-$STATE/swap-window.json}"
BRAIN_URL="${SWAP_BRAIN_URL:-http://127.0.0.1:11434}"
BRAIN_UNIT="${SWAP_BRAIN_UNIT:-jarvis-engine}"
BRAIN_START_CMD="${SWAP_BRAIN_START_CMD:-docker start}"
BRAIN_STOP_CMD="${SWAP_BRAIN_STOP_CMD:-docker stop}"
ART_URL="http://127.0.0.1:8120"
BENCH_URL="http://127.0.0.1:8121"
NOTIFY_CMD="${SWAP_NOTIFY_CMD:-jarvis-discord notify}"
MAINTAIN_DEFAULT=4h
VRAM_FREE_WANT_MB=12500     # art's min_free gate is 12 GB; leave headroom
VRAM_WAIT_S=180
ART_LOAD_WAIT_S=600         # Z-Image-Turbo: 32.9 GB of weights -> RAM/bf16
BRAIN_LOAD_WAIT_S=900       # 27B Q4 + 128K ctx takes minutes (watchdog grace is 600)
SWAP_PRIORITY_DEFAULT=1000  # bumped photo jobs must outrun every other job
                           # in their band (e.g. sonnet jobs whose VRAM
                           # assumptions break during the window)
DRY_RUN=0

mkdir -p "$STATE"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [jarvis-swap] $*"
  echo "$(date '+%Y-%m-%d %H:%M:%S') [jarvis-swap] $*" >> "$LOG"
}

notify() {
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would notify: $1"
    return 0
  fi
  log "NOTIFY: $1"
  $NOTIFY_CMD "$1" >/dev/null 2>&1 || log "notify failed (continuing): $1"
}

# http_probe <base-url> — status code of <base>/health; 000 on connection failure.
http_probe() {
  local code
  code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' "$1/health" 2>/dev/null) || code=000
  echo "$code"
}

vram_free_mb() {
  nvidia-smi --query-gpu=memory.total,memory.used --format=csv,noheader,nounits 2>/dev/null \
    | awk -F', *' 'NR==1 {print $1 - $2}'
}

wait_vram() {
  local want="$1" max="${2:-$VRAM_WAIT_S}" free i
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would wait for ${want} MB free VRAM (up to ${max} s)"
    return 0
  fi
  log "waiting for ${want} MB free VRAM (up to ${max} s) ..."
  for (( i = 0; i < max; i++ )); do
    free=$(vram_free_mb)
    if [[ -n "$free" ]] && (( free >= want )); then
      log "VRAM free: ${free} MB"
      return 0
    fi
    sleep 2
  done
  log "ERROR: VRAM did not reach ${want} MB free in ${max} s (now $(vram_free_mb 2>/dev/null || echo '?') MB)"
  return 1
}

# wait_health <base> <label> <max-tries-seconds> — poll /health until non-000.
wait_health() {
  local base="$1" label="$2" max="${3:-60}" code i
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would wait for $label health at $base (up to ${max} s)"
    return 0
  fi
  log "waiting for $label health at $base (up to ${max} s) ..."
  for (( i = 0; i < max; i += 5 )); do
    code=$(http_probe "$base")
    [[ "$code" != "000" ]] && { log "$label is healthy (HTTP $code)"; return 0; }
    sleep 5
  done
  log "ERROR: $label not healthy after ${max} s"
  return 1
}

# wait_art_loaded — art's /health JSON reports loaded:true once the pipeline
# is resident; the model load takes a few minutes after container start.
wait_art_loaded() {
  local max="${1:-$ART_LOAD_WAIT_S}" i body
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would wait for art model to load (up to ${max} s)"
    return 0
  fi
  log "waiting for art model to load (up to ${max} s) ..."
  for (( i = 0; i < max; i += 10 )); do
    body=$(curl -s -m 5 "$ART_URL/health" 2>/dev/null) || body=""
    if printf '%s' "$body" | grep -q '"loaded":true'; then
      log "art model loaded: $(printf '%s' "$body" | head -c 160)"
      return 0
    fi
    sleep 10
  done
  log "ERROR: art model not loaded after ${max} s (last health: ${body:-none})"
  return 1
}

# api_check — the S3.3 pattern from scripts/engine-switch: a real completion
# must come back, not just a /health 200.
api_check() {
  local resp
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would run API check against $BRAIN_URL"
    return 0
  fi
  log "API check: sending a 8-token completion to the brain ..."
  resp=$(curl -sf -m 60 -X POST "$BRAIN_URL/v1/chat/completions" \
    -H 'Content-Type: application/json' \
    -d '{"model":"test","messages":[{"role":"user","content":"Say ok in one word."}],"max_tokens":8}' 2>&1) \
    || { log "ERROR: API check failed (curl): ${resp:0:200}"; return 1; }
  if printf '%s' "$resp" | grep -q '"choices"'; then
    log "API check PASSED"
    return 0
  fi
  log "ERROR: API check failed (no choices): ${resp:0:200}"
  return 1
}

parse_dur() {
  local d="${1//[[:space:]]/}"
  if [[ "$d" =~ ^([0-9]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"; return 0
  fi
  if [[ "$d" =~ ^([0-9]+)([smh])$ ]]; then
    local n=$(( BASH_REMATCH[1] ))
    case "${BASH_REMATCH[2]}" in
      s) echo "$n" ;;
      m) echo $(( n * 60 )) ;;
      h) echo $(( n * 3600 )) ;;
    esac
    return 0
  fi
  return 1
}

brain_up() { [[ "$(http_probe "$BRAIN_URL")" != "000" ]]; }

# window_state_write <caps> <reason> — record the open window (for-list,
# reason, opened_at) in $WINDOW_STATE. Written EARLY in `out` (before the
# watchdog/stop/load steps) so a concurrent resourced tick sees the window
# as open while the swap is in flight and does not try to open a second
# one. Kept on every failure path (the window really is half-open then);
# cleared only by a successful `in`. An idempotent re-run preserves the
# original opened_at (it is not a new window).
window_state_write() {
  local caps="$1" reason="$2" ts items cap
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ -f "$WINDOW_STATE" ]]; then
    local old
    old=$(sed -n 's/.*"opened_at":"\([^"]*\)".*/\1/p' "$WINDOW_STATE")
    [[ -n "$old" ]] && ts="$old"
  fi
  items=""
  IFS=',' read -ra carr <<< "${caps// /}"
  for cap in "${carr[@]}"; do
    [[ -z "$cap" ]] && continue
    items="${items:+$items,}\"$cap\""
  done
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would write $WINDOW_STATE (for: ${caps:-none}, opened $ts)"
    return 0
  fi
  printf '{"for":[%s],"reason":"%s","opened_at":"%s"}\n' \
    "$items" "$reason" "$ts" > "$WINDOW_STATE"
  log "window state: $WINDOW_STATE (for: ${caps:-none}, opened $ts)"
}

# window_state_clear — a successful `in` closed the window; drop the marker.
window_state_clear() {
  [[ -f "$WINDOW_STATE" ]] || return 0
  if [[ "$DRY_RUN" == 1 ]]; then
    log "[DRY-RUN] would remove $WINDOW_STATE"
    return 0
  fi
  rm -f "$WINDOW_STATE"
  log "window state cleared"
}

# window_state_line — one line for `status`: the open window's for-list,
# age and reason (or none).
window_state_line() {
  if [[ ! -f "$WINDOW_STATE" ]]; then
    echo "  window       none"
    return 0
  fi
  local body since for_list reason since_s age
  body=$(cat "$WINDOW_STATE")
  since=$(printf '%s' "$body" | sed -n 's/.*"opened_at":"\([^"]*\)".*/\1/p')
  for_list=$(printf '%s' "$body" | sed -n 's/.*"for":\[\([^]]*\)\].*/\1/p' | tr -d '"')
  reason=$(printf '%s' "$body" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')
  if since_s=$(date -d "$since" +%s 2>/dev/null); then
    age=$(( $(date +%s) - since_s ))
    echo "  window       open for: ${for_list:-?} (${age} s) — ${reason:-no reason}"
  else
    echo "  window       open for: ${for_list:-?} (opened ${since:-?}) — ${reason:-no reason}"
  fi
}

########################################
# status
########################################
cmd_status() {
  local free
  free=$(vram_free_mb)
  echo "jarvis-swap status — $(date '+%Y-%m-%d %H:%M:%S %Z')"
  echo "  brain ctr    $(docker inspect -f '{{.State.Status}}' "$BRAIN_UNIT" 2>/dev/null || echo missing)  ($BRAIN_URL/health -> $(http_probe "$BRAIN_URL"))"
  echo "  VRAM         ${free:-?} MB free of $(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1) MB"
  echo "  art (8120)   $(http_probe "$ART_URL")  $(curl -s -m 3 "$ART_URL/health" 2>/dev/null | head -c 120)"
  echo "  bench (8121) $(http_probe "$BENCH_URL")  $(curl -s -m 3 "$BENCH_URL/health" 2>/dev/null | head -c 120)"
  echo "  maintenance  $(jarvis-watchdog maintain status 2>/dev/null)"
  window_state_line
  local hf="$REPO/notes/brain-handoff.md"
  if [[ -f "$hf" ]]; then
    local age=$(( $(date +%s) - $(stat -c %Y "$hf") ))
    echo "  handoff      $hf (${age} s old)"
  else
    echo "  handoff      none"
  fi
  echo "  running jobs $(jarvis-jobs list running 2>/dev/null | awk '$1 == "running"' | wc -l)"
  echo "  log          $LOG"
}

########################################
# out
########################################
cmd_out() {
  local maintain="$MAINTAIN_DEFAULT" forcaps="" jobs="" reason="GPU capability work" job="" force=0 bump="$SWAP_PRIORITY_DEFAULT"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) forcaps="$2"; shift 2 ;;
      --maintain) maintain="$2"; shift 2 ;;
      --jobs) jobs="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --job) job="$2"; shift 2 ;;
      --bump) bump="$2"; shift 2 ;;
      --force) force=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      *) echo "unknown argument: $1" >&2; return 2 ;;
    esac
  done

  log "=== swap OUT (for=${forcaps:-none} maintain=${maintain} jobs=${jobs:-none} reason=${reason}) ==="

  # Round guard: this must run BETWEEN brain rounds, never under one. When
  # a swap job is dispatched as a round it is the only running job; a
  # manual run (none running) — or resourced's automated open — needs
  # --force because it kills the brain out from under anyone using it.
  # --force only covers the "no round running" case: with ANY round in
  # flight and no matching --job, the answer is always no (invariant 1 —
  # the brain never stops itself mid-round, not even on automation's say-so).
  # jarvis-jobs list prints "<status>  <id>  <text>" lines plus a "# N jobs:"
  # footer — take only real running lines, ids in column 2.
  local running
  running=$(jarvis-jobs list running 2>/dev/null | awk '$1 == "running" {print $2}')
  local n
  n=$(printf '%s\n' "$running" | grep -c . || true)
  [[ -n "$running" ]] || n=0
  if [[ "$n" -ge 2 ]]; then
    log "ABORT: $n jobs are running — a round is in flight; do not swap out under it"
    notify "swap OUT aborted: $n rounds running (see $LOG)"
    return 1
  fi
  if [[ "$n" -eq 1 && ( -z "$job" || "$running" != "$job" ) ]]; then
    log "ABORT: round ${running} is in flight and this is not it (job=${job:-none}) — --force does not bypass a running round"
    notify "swap OUT aborted: round ${running} is in flight (see $LOG)"
    return 1
  fi
  if [[ "$n" -eq 0 && "$force" -ne 1 ]]; then
    log "ABORT: no round is running — this looks like a manual run; use --force to stop the brain deliberately"
    return 1
  fi

  # Already out? Idempotent: (re)flip the jobs and leave the window as is.
  if ! brain_up; then
    if jarvis-watchdog maintain status 2>/dev/null | grep -q "maintenance active"; then
      log "brain already down and a maintenance window is active — window already open"
    else
      log "ABORT: brain is down and NO maintenance window is active — this is not a swap, it is the 2026-11-04 failure mode. Leaving it for the watchdog."
      notify "swap OUT aborted: brain down without a maintenance window — the watchdog owns this, not the swap"
      return 1
    fi
  fi

  # Record the window EARLY, before the long steps below (VRAM drain and
  # the art model load can take minutes): a concurrent resourced tick must
  # see the window as open while the swap is in flight, or it would try to
  # open a second one. The marker is kept on every failure path — the
  # window really is half-open then; only a successful `in` clears it.
  window_state_write "$forcaps" "$reason"

  # 1. Open the failsafe BEFORE touching the brain: while the window is
  #    unexpired the watchdog will not restart the brain mid-swap, and at
  #    the deadline it re-arms the brain no matter what died below.
  if [[ "$DRY_RUN" == 0 ]]; then
    jarvis-watchdog maintain "$maintain" "capability swap window: $reason" || {
      log "ERROR: could not open the watchdog maintenance window — aborting before touching the brain"
      return 1
    }
  else
    log "[DRY-RUN] would run: jarvis-watchdog maintain $maintain \"capability swap window: $reason\""
  fi

  # 2. Unload the brain (the docker container serving 11434).
  if [[ "$DRY_RUN" == 0 ]]; then
    log "stopping brain container $BRAIN_UNIT ..."
    $BRAIN_STOP_CMD "$BRAIN_UNIT" || {
      log "ERROR: $BRAIN_STOP_CMD $BRAIN_UNIT failed"
      return 1
    }
  else
    log "[DRY-RUN] would run: $BRAIN_STOP_CMD $BRAIN_UNIT"
  fi

  # 3. Wait for the VRAM to actually come back (CUDA release is not instant).
  wait_vram "$VRAM_FREE_WANT_MB" || return 1

  # 4. Load the photo services. `up -d` is a no-op for ones already running;
  #    the art model load is what takes minutes.
  if [[ "$DRY_RUN" == 0 ]]; then
    (cd "$REPO" && docker compose up -d art bench) || {
      log "ERROR: docker compose up -d art bench failed"
      return 1
    }
  else
    log "[DRY-RUN] would run: docker compose up -d art bench"
  fi
  wait_health "$ART_URL" "art" 60 || return 1
  wait_art_loaded || return 1
  wait_health "$BENCH_URL" "bench" 120 || return 1

  # 5. Flip the queued jobs to the iGPU driver AND push them to the front
  #    of their band. Jobs run as code when tagged (e.g. photo jobs — the
  #    jarvis-photo executor, no model round), so the driver label is
  #    vestigial for them; the flip exists for band priority and for the
  #    swap bracket's own jobs. The priority bump also keeps unrelated jobs
  #    (e.g. sonnet VRAM sweeps) out of the window: while the brain is
  #    down, jarvis-jobs next skips local jobs, so the only things that run
  #    are the bumped jobs and whatever already outran them. resourced's
  #    automated windows pass no --jobs: photo-tagged jobs already bypass
  #    the engine gate in jarvis-jobs next.
  local flipped="" id st
  IFS=',' read -ra jarr <<< "${jobs// /}"
  for id in "${jarr[@]}"; do
    [[ -z "$id" ]] && continue
    if [[ "$DRY_RUN" == 1 ]]; then
      log "[DRY-RUN] would run: jarvis-jobs requeue -driver igpu -priority $bump $id"
      continue
    fi
    st=$(jarvis-jobs show "$id" 2>/dev/null | sed -n 's/^status: //p')
    if [[ "$st" != "ready" ]]; then
      log "skip flip of $id (status: ${st:-missing})"
      continue
    fi
    # Go's flag package stops at the first non-flag arg: flags go first.
    if jarvis-jobs requeue -driver igpu -priority "$bump" "$id" >/dev/null 2>&1; then
      flipped="${flipped:+$flipped,}$id"
      log "flipped $id to igpu"
    else
      log "ERROR: could not flip $id to igpu"
      notify "swap OUT: brain is off but flipping $id failed (see $LOG) — the window stays open until the watchdog deadline"
      return 1
    fi
  done

  # 6. Tell the house.
  local until
  until=$(jarvis-watchdog maintain status 2>/dev/null | sed -n 's/maintenance active: brain restarts skipped until \([^ (]*\).*/\1/p')
  notify "brain swap OUT: brain paused for GPU capability work ($reason; window serves ${forcaps:-?}). art+bench on the 4090; capability jobs run as code (no model round), window until ${until:-?}. I pick up from notes/brain-handoff.md when I am back. Flipped: ${flipped:-none}."
  log "=== swap OUT complete ==="
  return 0
}

########################################
# in
########################################
cmd_in() {
  local reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) reason="$2"; shift 2 ;;
      --dry-run) DRY_RUN=1; shift ;;
      *) echo "unknown argument: $1" >&2; return 2 ;;
    esac
  done

  log "=== swap IN (reason=${reason:-none}) ==="

  # Idempotent: if the brain is already serving (the watchdog re-armed it at
  # the deadline, or a round started it), just close the window. Closing it
  # matters even with the brain up: a live maintenance window would keep the
  # watchdog from restarting the brain if it died before the deadline.
  if brain_up; then
    log "brain already serving — only closing the maintenance window"
    if [[ "$DRY_RUN" == 0 ]]; then
      jarvis-watchdog maintain off || log "WARNING: 'jarvis-watchdog maintain off' failed"
    else
      log "[DRY-RUN] would run: jarvis-watchdog maintain off"
    fi
  else
    # 1. Close the failsafe first: from here on the watchdog may restart the
    #    brain on its own if our own start below goes wrong.
    if [[ "$DRY_RUN" == 0 ]]; then
      jarvis-watchdog maintain off || log "WARNING: 'jarvis-watchdog maintain off' failed"
    else
      log "[DRY-RUN] would run: jarvis-watchdog maintain off"
    fi

    # 2. Unload the photo services.
    if [[ "$DRY_RUN" == 0 ]]; then
      log "stopping photo services (art, bench) ..."
      (cd "$REPO" && docker compose stop art bench) || log "WARNING: docker compose stop art bench failed"
    else
      log "[DRY-RUN] would run: docker compose stop art bench"
    fi
    wait_vram 2000 || log "WARNING: VRAM did not fully clear; continuing (the brain loads on top of whatever is free)"

    # 3. Reload the brain.
    if [[ "$DRY_RUN" == 0 ]]; then
      log "starting brain container $BRAIN_UNIT ..."
      $BRAIN_START_CMD "$BRAIN_UNIT" || {
        log "ERROR: could not start $BRAIN_UNIT — the watchdog will keep trying (maintain is off)"
        notify "swap IN FAILED: brain would not start (see $LOG) — the watchdog is retrying"
        return 1
      }
    else
      log "[DRY-RUN] would run: $BRAIN_START_CMD $BRAIN_UNIT"
    fi

    # 4. Wait it out — a 27B Q4 with 128K ctx takes minutes to load.
    wait_health "$BRAIN_URL" "brain" "$BRAIN_LOAD_WAIT_S" || {
      notify "swap IN FAILED: brain not healthy after ${BRAIN_LOAD_WAIT_S} s (see $LOG) — the watchdog is retrying"
      return 1
    }

    # 5. Prove it can actually answer, not just serve /health.
    api_check || {
      notify "swap IN: brain healthy but the API check failed (see $LOG) — one more round of the watchdog's grace applies"
      return 1
    }
  fi

  # The window is closed: drop the marker (resourced's State() reads it).
  # Reached only on success — the failure paths above return before this,
  # leaving the marker in place for a retry.
  window_state_clear

  notify "brain swap IN: brain is back on :11434, capability window closed. ${reason:+($reason)}"
  log "=== swap IN complete ==="
  return 0
}

########################################
# handoff — scaffold notes/brain-handoff.md
########################################
cmd_handoff() {
  local hf="$REPO/notes/brain-handoff.md"
  if [[ -f "$hf" && "$#" -ne 1 ]]; then
    echo "refusing to overwrite an existing $hf (pass --force to replace)" >&2
    return 1
  fi
  local ts queue
  ts=$(date '+%Y-%m-%d %H:%M %Z')
  queue=$(jarvis-jobs list 2>/dev/null | grep -vE '^(done|skipped|failed)' | head -25)
  {
    cat <<EOF
# Brain handoff — $ts (current window only)

<!-- Written by the brain before a swap window (docs/brain-swap.md). This
     file is the pointer for THE CURRENT WINDOW ONLY: which jobs are in it
     and the first step on return. The durable record per job is its
     continuation — jobs/<id>/continuation.md, written by \`jarvis-jobs yield\`
     before the job parked — which outlives the window. The next brain round
     reads this file first, does "First thing on return", verifies, then moves
     this file to notes/archive/; the continuations stay in the job store. -->

## Window
- window: $(jarvis-watchdog maintain status 2>/dev/null | sed 's/maintenance active: //')

## Jobs in this window
- (job id): continue from jobs/<id>/continuation.md

## First thing on return
- (the exact next step — one or two lines, no re-planning needed)

## Verify on return
- [ ] jarvis-swap status: brain healthy, no maintenance window
- [ ] (photo results verified)
- [ ] (conversation note + jarvis-notes done for the swap round)

## Queue at handoff time
\`\`\`
$queue
\`\`\`
EOF
  } > "$hf"
  log "wrote handoff scaffold: $hf"
  echo "$hf"
}

########################################
# main
########################################
case "${1:-}" in
  status)   shift; cmd_status "$@" ;;
  out)      shift; cmd_out "$@" ;;
  in)       shift; cmd_in "$@" ;;
  handoff)  shift; cmd_handoff "$@" ;;
  help|-h|--help)
    grep -E '^#( |$)' "$0" | head -45 | sed 's/^# \{0,1\}//' ;;
  *)
    echo "usage: jarvis-swap status | out | in | handoff | help" >&2
    exit 2 ;;
esac
