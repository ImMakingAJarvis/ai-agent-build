#!/usr/bin/env python3
"""jarvis-secrets — add, list, fetch and remove Jarvis secrets.

Secrets Nathan can give the agent: API keys, tokens, passwords. The
dashboard page (/secrets on :8080) can add and remove them but never shows
a value; this CLI is the agent-side reader.

Storage: one file per secret under $JARVIS_SECRETS_DIR, or
$JARVIS_DATA_DIR/secrets, or ~/.local/share/jarvis/secrets — the same
directory the dashboard's store (internal/secrets) uses. Directory 0700,
files 0600, atomic writes. The name rules match the Go store exactly:
letters, digits, '.', '_' and '-', starting with a letter or digit,
1-128 chars.

Values are read from stdin (or -f), never from argv, so they do not land
in shell history or process listings.

Usage:
  jarvis-secrets list                 names only (no values)
  jarvis-secrets add NAME             read value from stdin
  jarvis-secrets add NAME -f FILE     read value from a file
  jarvis-secrets get NAME             print value to stdout
  jarvis-secrets rm NAME              remove
"""
import os
import re
import sys
import tempfile

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
MAX_LEN = 1 << 20


def die(msg, code=1):
    print("jarvis-secrets: " + msg, file=sys.stderr)
    sys.exit(code)


def root():
    d = os.environ.get("JARVIS_SECRETS_DIR")
    if not d:
        d = os.environ.get("JARVIS_DATA_DIR") or os.path.join(
            os.path.expanduser("~"), ".local", "share", "jarvis")
        d = os.path.join(d, "secrets")
    return d


def check_name(name):
    if not NAME_RE.match(name):
        die(f"bad secret name {name!r} (letters, digits, '.', '_', '-', "
            "starting with a letter or digit, 1-128 chars)")


def cmd_list(_args):
    r = root()
    if not os.path.isdir(r):
        return
    for name in sorted(os.listdir(r)):
        p = os.path.join(r, name)
        if os.path.isfile(p) and NAME_RE.match(name):
            print(name)


def cmd_add(args):
    if len(args) != 1:
        die("usage: jarvis-secrets add NAME  (value from stdin)")
    name = args[0]
    check_name(name)
    value = sys.stdin.read()
    if value.endswith("\n") and not value.endswith("\n\n"):
        value = value[:-1]  # a trailing newline from echo/printf is not part of the value
    if len(value) > MAX_LEN:
        die(f"value too large ({len(value)} bytes, max {MAX_LEN})")
    r = root()
    os.makedirs(r, mode=0o700, exist_ok=True)
    os.chmod(r, 0o700)  # umask may have masked the mkdir mode
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=r)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(value.encode("utf-8"))
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, os.path.join(r, name))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    print(f"stored {name} ({len(value)} bytes)")


def cmd_get(args):
    if len(args) != 1:
        die("usage: jarvis-secrets get NAME")
    name = args[0]
    check_name(name)
    p = os.path.join(root(), name)
    try:
        with open(p, "r", encoding="utf-8") as f:
            sys.stdout.write(f.read())
    except FileNotFoundError:
        die(f"no secret named {name!r}")


def cmd_rm(args):
    if len(args) != 1:
        die("usage: jarvis-secrets rm NAME")
    name = args[0]
    check_name(name)
    p = os.path.join(root(), name)
    try:
        os.unlink(p)
    except FileNotFoundError:
        die(f"no secret named {name!r}")
    print(f"removed {name}")


def main():
    argv = sys.argv[1:]
    if not argv:
        die("usage: jarvis-secrets {list|add NAME|get NAME|rm NAME}")
    cmd, args = argv[0], argv[1:]
    if cmd == "list":
        cmd_list(args)
    elif cmd == "add":
        cmd_add(args)
    elif cmd == "get":
        cmd_get(args)
    elif cmd == "rm":
        cmd_rm(args)
    else:
        die(f"unknown command {cmd!r}")


if __name__ == "__main__":
    main()
