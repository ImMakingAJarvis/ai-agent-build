#!/usr/bin/env bash
#
# agent-run: runs the bootstrap agent in stages, switching models.
#
#   Stage 1 (cheap model, default "haiku"): NVIDIA driver + CUDA install,
#     ending with a working nvidia-smi. If it doesn't get there, escalate
#     to the stronger model (default "sonnet") in the SAME conversation.
#   Stage 2 (strong model): install Ollama and set up a local "brain"
#     model that can drive Claude Code itself (see agent-local), then stop.
#   Checkpoint: DM the owner what got set up and wait for the go-ahead.
#   Stage 3: supervised rounds through the rest of TASKS.md. Each round is
#     run by whichever driver the owner picks on Discord: the local model
#     (default; it pulls the coding model and builds the queue system) or
#     the strong model when the local one is stuck. Every round ends with
#     the owner choosing what happens next. NoBrakes full-auto mode
#     (the nobrakes:full_auto Redis flag, flipped with !fullauto) skips
#     the question and runs the next ready job immediately, at any time
#     of day, for as long as the queue has work. Safety guardrails
#     (NoBrakes 6/6): at most one concurrent auto job (the
#     nobrakes:running marker), an auto job that failed pauses the
#     feature and notifies the owner — unless keep-going is on
#     (nobrakes:keep_going, flipped with !keepgoing or the "Keep going"
#     checkpoint button), when the failure only notifies — and manual
#     rounds are never blocked by the feature.
#
#   Photo window: jobs tagged `photo` (jarvis-jobs photo-ready lists them)
#     need the 4090 without the brain. Before the first one runs the loop
#     opens a brain-swap window (jarvis-swap out: brain out, art+bench up,
#     batch flipped to priority 1000); when the ready batch drains it
#     closes it (jarvis-swap in: brain back). Photo jobs run as code —
#     the jarvis-photo executor, no model round (not even the iGPU
#     helper). The loop only closes windows it opened itself
#     ($CONF/photo-window marker) — see docs/brain-swap.md and
#     docs/agent-run.md.
#
#   agent-run                         first run, or carry on after "Stop"
#   agent-run --resume REASON [GPU]   after a reboot (called by agent-resume)
#
# The script, not the model, decides whether a stage succeeded: it runs
# nvidia-smi after stage 1 and `agent-local check` after stage 2.
#
# Env (persisted in agent.env for the post-reboot service):
#   AGENT_STAGE1_MODEL  default haiku   (set to sonnet to skip the cheap pass)
#   AGENT_STAGE2_MODEL  default sonnet
#
# State: $CONF/stage is "1", "1e" (stage 1, escalated), "2" or "3".
#        $CONF/driver is "local", "igpu" or "sonnet" (who ran the last
#        stage-3 round).
# Briefs written by bootstrap.sh: $CONF/stage1.txt, stage2.txt,
#        stage3-local.txt, stage3-igpu.txt, stage3-sonnet.txt.
#
# The igpu driver runs the round on the small always-on iGPU model
# (jarvis-engine-igpu, port 11435) via agent-local — it needs no 4090
# and no API, so it is the right choice for rounds that must free the
# GPU (e.g. the MoE VRAM sweeps) without paying for Sonnet.
# IGPU_MODEL / IGPU_URL / IGPU_CONTEXT_TOKENS override the defaults.

set -uo pipefail

CONF="${JARVIS_CONF:-$HOME/.config/jarvis}"
STATE="$CONF/stage"
DRIVER="$CONF/driver"
M1="${AGENT_STAGE1_MODEL:-haiku}"
M2="${AGENT_STAGE2_MODEL:-sonnet}"

notify() { jarvis-discord notify "$1" || true; }
gpu_ok() { nvidia-smi -L >/dev/null 2>&1; }

# If the agent ran agent-reboot, the machine is shutting down and the
# driver won't be loaded until it's back. Stop here without touching the
# stage, so agent-resume carries on the same stage after boot.
exit_if_rebooting() {
  if [[ -f "$CONF/resume-pending" ]]; then
    echo "==> reboot in progress; agent-resume will continue stage $stage"
    exit 0
  fi
}

# run_claude MODEL CONTINUE(0|1) PROMPT    (MODEL "local" = agent-local)
run_claude() {
  local model="$1" cont="$2" prompt="$3" cmd=(claude --model "$1")
  local args=(--dangerously-skip-permissions)
  if [[ "$model" == local ]]; then
    cmd=(agent-local)
  elif [[ "$model" == igpu ]]; then
    # The small iGPU model: agent-local pointed at the iGPU engine.
    # agent-local honours the pre-set values over its local.env.
    cmd=(env ENGINE_URL="${IGPU_URL:-http://localhost:11435}" \
         LOCAL_MODEL="${IGPU_MODEL:-jarvis-igpu}" \
         LOCAL_CONTEXT_TOKENS="${IGPU_CONTEXT_TOKENS:-32768}" \
         CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384 agent-local)
  fi
  (( cont )) && args+=(--continue)
  echo "==> $(date '+%F %T') $model continue=$cont"
  "${cmd[@]}" "${args[@]}" -p "$prompt"
}

resume=0; reason=""; gpu=""
if [[ "${1:-}" == "--resume" ]]; then
  resume=1; reason="${2:-unknown}"; gpu="${3:-}"
fi

stage=$(cat "$STATE" 2>/dev/null || echo 1)

resume_prompt() {  # $1 = what to do next
  printf 'The machine just rebooted (reason: %s) and you were resumed automatically. If the last command you ran was agent-reboot, it succeeded. nvidia-smi at boot said: %s\n\nFirst check that whatever needed the reboot worked. Then %s' \
    "$reason" "${gpu:-none}" "$1"
}

# ---------------------------------------------------------------- stage 1
if [[ "$stage" == "1" ]]; then
  if (( resume )); then
    p=$(resume_prompt "finish stage 1 only: confirm nvidia-smi works and CUDA is installed, tell me on Discord, then stop. Do not start other tasks.")
    run_claude "$M1" 1 "$p"; status=$?
  else
    run_claude "$M1" 0 "$(cat "$CONF/stage1.txt")"; status=$?
  fi
  exit_if_rebooting

  if gpu_ok; then
    echo 2 > "$STATE"; stage=2; resume=0
    notify "Stage 1 done ($M1): GPU works. Starting stage 2 on $M2: setting up the local model."
  else
    echo 1e > "$STATE"; stage=1e
    out=$(nvidia-smi 2>&1 | head -n 5)
    notify "Stage 1 on $M1 did not end with a working GPU (exit $status). Escalating to $M2."
    p="The previous run (model: $M1) ended without a working GPU. Look at what it did (this is the same conversation) and at the machine's current state, then diagnose and fix it: get nvidia-smi working and CUDA installed. If a reboot is needed, use agent-reboot. nvidia-smi currently says:
$out

When nvidia-smi works, tell me on Discord and stop. Do not start other tasks."
    run_claude "$M2" 1 "$p"; status=$?
    exit_if_rebooting
    if gpu_ok; then
      echo 2 > "$STATE"; stage=2; resume=0
      notify "Stage 1 fixed by $M2: GPU works. Starting stage 2: setting up the local model."
    else
      notify "GPU still not working after escalation to $M2. Stopping so you can look at it."
      exit 1
    fi
  fi
fi

# ------------------------------------------------- stage 1, escalated, resumed
if [[ "$stage" == "1e" ]]; then
  p=$(resume_prompt "finish the driver fix only: confirm nvidia-smi works and CUDA is installed, tell me on Discord, then stop. Do not start other tasks.")
  run_claude "$M2" 1 "$p"; status=$?
  exit_if_rebooting
  if gpu_ok; then
    echo 2 > "$STATE"; stage=2; resume=0
    notify "Stage 1 fixed by $M2: GPU works. Starting stage 2: setting up the local model."
  else
    notify "GPU still not working after escalation to $M2. Stopping so you can look at it."
    exit 1
  fi
fi

# ---------------------------------------------------------------- stage 2
if [[ "$stage" == "2" ]]; then
  if (( resume )); then
    p=$(resume_prompt "carry on with stage 2 from where you left off: the local model must pass \`agent-local check\`. Then stop. Do not start other tasks.")
    run_claude "$M2" 1 "$p"
  else
    run_claude "$M2" 0 "$(cat "$CONF/stage2.txt")"
  fi
  exit_if_rebooting

  if agent-local check; then
    echo 3 > "$STATE"; stage=3; resume=0
  else
    notify "Stage 2 ended, but \`agent-local check\` fails: the local model can't drive Claude Code yet. Stopping so you can look. Run agent-run as $(whoami) to retry stage 2."
    exit 1
  fi

  # shellcheck disable=SC1091
  source "$CONF/local.env"
  checkpoint="Local model is set up and passed the takeover check.
Brain: ${LOCAL_MODEL}   Coder: ${LOCAL_CODER_MODEL:-same as brain}
$(ollama ps 2>&1 | head -n 4)
$(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader 2>&1 | sed 's/^/VRAM: /')
Details are in docs/local-brain.md on the stage-2 PR. Have a look, then pick who runs the build from here. You can also type instructions for the local model instead of pressing a button."
fi

# ---------------------------------------------------------------- stage 3
# A reboot mid-round resumes that round's conversation on the same driver.
if (( resume )); then
  d=$(cat "$DRIVER" 2>/dev/null || echo local)
  if [[ "$d" == superagent ]]; then
    # A superagent round is one self-contained command (cmd/superagent),
    # not a Claude conversation — there is no conversation to resume. Put
    # the job back in the queue for a fresh run.
    if [[ -f "$CONF/current-job" ]]; then
      jid="$(cat "$CONF/current-job")"
      jarvis-jobs requeue "$jid" || true
      rm -f "$CONF/current-job"
    fi
    summary "superagent" 0
    exit 0
  fi
  if [[ "$d" == local || "$d" == igpu ]]; then m="$d"; else m="$M2"; fi
  # Tag the session with the job id (as jarvis-jobs run does) so the
  # owner-message hook injects queue-site messages into this round too.
  resume_p="$(resume_prompt "carry on with what you were doing, following the same rules as before.")"
  if [[ -f "$CONF/current-job" ]]; then
    JARVIS_JOB_ID="$(cat "$CONF/current-job")" run_claude "$m" 1 "$resume_p"; status=$?
  else
    run_claude "$m" 1 "$resume_p"; status=$?
  fi
  exit_if_rebooting
  # The round that rebooted was a queued job: record how it ended.
  if [[ -f "$CONF/current-job" ]]; then
    jid="$(cat "$CONF/current-job")"
    jarvis-jobs finish "$jid" "$status" || true
    rm -f "$CONF/current-job"
    # NoBrakes 6/6: if that was a full-auto round that failed, pause
    # autonomous execution and notify — same as the main loop path
    # (keep-going: notify without pausing when keep_going is on).
    if [[ "$(jarvis-jobs fullauto 2>/dev/null || echo off)" == "on" ]]; then
      job_status=$(jarvis-jobs list 2>/dev/null | awk -v id="$jid" '$2 == id {print $1}')
      if [[ "$job_status" == "failed" ]]; then
        if [[ "$(jarvis-jobs keepgoing 2>/dev/null || echo off)" == "on" ]]; then
          jarvis-jobs failnote "$jid" || true
        else
          jarvis-jobs autopause "$jid" || true
        fi
      fi
    fi
  fi
fi

summary() {
  local prs
  prs=$(GH_TOKEN=$(ghapp-token 2>/dev/null) gh pr list --state open --limit 5 \
          --json number,title,url --jq '.[] | "#\(.number) \(.title) \(.url)"' 2>/dev/null)
  printf 'The %s run on %s has ended (exit %s).\nOpen PRs:\n%s' \
    "$1" "$(hostname)" "$2" "${prs:-none}"
}

# Work comes from the queue: each round takes the next ready agent job
# (jarvis-jobs next: highest priority, then oldest, dependencies done),
# names it at the checkpoint, and runs it on the driver you choose.
# discord_watcher_pid tracks the background Discord watcher so we can kill
# it when a job finishes (or was paused by the user).
discord_watcher_pid=

stop_watcher() {
  if [[ -n "$discord_watcher_pid" ]]; then
    kill "$discord_watcher_pid" 2>/dev/null || true
    wait "$discord_watcher_pid" 2>/dev/null || true
    discord_watcher_pid=
  fi
}

# jarvis_chat_running reports whether the Discord chat daemon is up anywhere:
# the Docker container (primary) or the host systemd unit (fallback).
jarvis_chat_running() {
  systemctl is-active --quiet jarvis-chat && return 0
  docker inspect --format '{{.State.Running}}' jarvis-chat 2>/dev/null | grep -q '^true$'
}

start_watcher() {
  # When jarvis-chat is running (container or host unit), it already listens
  # for owner DMs and answers them — no need to run a separate pause watcher.
  # The !pause command is handled by jarvis-chat itself (it writes the
  # pause-signal file). Skip the watcher to avoid killing the round
  # on every normal message.
  if jarvis_chat_running; then
    return
  fi
  rm -f "$CONF/pause-signal"  # clear any stale signal
  jarvis-discord watch &
  discord_watcher_pid=$!
}

# ---- Brain-swap photo window (docs/brain-swap.md) -------------------------
# Photo-tagged jobs (the `photo` tag, set by image-queue ingestion or
# `jarvis-jobs add -tags photo`) need the 4090 without the brain: the
# art+bench services wait for ~12 GB free before generating. The loop
# brackets the whole ready batch with a swap window:
#   before the first photo job runs -> jarvis-swap out --jobs <batch>
#   when the batch drains           -> jarvis-swap in
# `out` is idempotent: re-run on an open window it re-flips the batch to
# igpu@1000 and extends the watchdog maintenance window, so photo jobs
# that arrive mid-window are picked up on the next pull. The $CONF/photo-window
# marker keeps the loop from closing a window it didn't open — a manual
# window for non-photo work (e.g. a VRAM sweep, docs/brain-swap.md) never
# gets a marker, so the loop leaves it alone. jarvis-swap notifies Discord
# on both out and in; the loop only speaks up on failure (once per failure
# stretch, photo_swap_warn).
swap_window_open() {
  jarvis-watchdog maintain status 2>/dev/null | grep -q 'maintenance active'
}

photo_batch() {  # comma-separated ids of the ready photo-tagged jobs, in run order
  jarvis-jobs photo-ready 2>/dev/null
}

is_photo_job() {
  jarvis-jobs show "$1" 2>/dev/null | sed -n 's/^tags: //p' \
    | tr ',' '\n' | grep -q '^[[:space:]]*photo[[:space:]]*$'
}

msg="${checkpoint:-$(summary "$(cat "$DRIVER" 2>/dev/null || echo agent)" "${status:-?}")}"
round=0
photo_swap_warn=0   # 1 once the loop has notified about a swap failure (reset on success)
while :; do
  # NoBrakes (2/6): read the Redis auto_mode flag on every iteration.
  # When it is on and today's nightly window is unprocessed, parked
  # nightly-tagged jobs are auto-enqueued (no manual trigger); when off,
  # or when Redis is unreachable, nothing changes — the check logs a
  # warning and exits 0, so it can never stall or kill the loop.
  jarvis-jobs nightly || true

  # Photo window, drained: the loop opened it (marker) and no ready
  # photo jobs are left — close it and put the brain back before pulling
  # anything else. A window without the marker is manual and stays the
  # owner's to close.
  if [[ -f "$CONF/photo-window" ]] && [[ -z "$(photo_batch)" ]]; then
    if jarvis-swap in --reason "photo window drained (queue watcher)"; then
      rm -f "$CONF/photo-window"
      photo_swap_warn=0
    elif (( photo_swap_warn == 0 )); then
      notify "Photo batch is empty but the window wouldn't close (jarvis-swap in failed) — retrying; the watchdog deadline re-arms the brain either way."
      photo_swap_warn=1
    fi
    continue
  fi

  job_id=""; job_title=""
  if next=$(jarvis-jobs next 2>/dev/null); then
    job_id="${next%%$'\t'*}"; job_title="${next#*$'\t'}"
  fi
  # NoBrakes full auto mode: when the full_auto flag is on, run
  # the next ready job immediately — at any time of day, not just the
  # nightly window — without asking who runs it, for as long as the
  # queue has work; with an empty queue it idle-polls instead of
  # asking. The flag is read fresh every iteration and fails safe to
  # off (Redis disabled or unreachable), so the supervised ask below is
  # the default. The owner overrides at any time: !fullauto off (or
  # `jarvis-jobs fullauto off`) takes effect on the next iteration, and
  # !pause / !restart still work mid-run.
  fullauto=$(jarvis-jobs fullauto 2>/dev/null || echo off)
  auto_run=0   # NoBrakes 6/6: 1 when this round runs under the auto guard
  if [[ "$fullauto" == "on" ]]; then
    if [[ -z "$job_id" ]]; then
      echo "==> full auto: queue empty, idle-polling (stop with !fullauto off)"
      sleep 60
      continue
    fi
    # Honor the job's own spec driver (e.g. the sonnet-gated jobs);
    # fall back to the driver of the last round (the $DRIVER file), then
    # local. Anything else — an empty file, "agent", a stale value —
    # normalizes to local.
    d=$(jarvis-jobs show "$job_id" 2>/dev/null | sed -n 's/^driver: //p')
    if ! [[ "$d" =~ ^(local|igpu|sonnet|superagent)$ ]]; then
      d=$(cat "$DRIVER" 2>/dev/null | tr -d '[:space:]')
    fi
    if ! [[ "$d" =~ ^(local|igpu|sonnet|superagent)$ ]]; then
      d=local
    fi
    note=""
    auto_run=1
    notify "Full auto: running ${job_title} (${job_id}) on ${d}."
  else
    # Photo-tagged jobs have no driver choice: the photo check below opens
    # the swap window and runs the job as CODE (the jarvis-photo executor —
    # no model round, not the iGPU helper), so "who runs it?" is a question
    # whose answer changes nothing (the only useful reply was Skip — the
    # owner can still skip a photo job from the queue). Dispatch them
    # straight away instead of asking.
    if [[ -n "$job_id" ]] && is_photo_job "$job_id"; then
      d=igpu
      note=""
      notify "Photo job ${job_title} (${job_id}): opening the swap window; the photo runs as code (jarvis-photo), no model round."
    else
      if [[ -n "$job_id" ]]; then
        q="Next: $job_title ($job_id). Who runs it? You can also type instructions for this round."
        choices="Local model,iGPU model,Sonnet,Super agent,Skip,Stop,Full auto,Auto mode,Keep going"
      else
        q="No ready jobs in the queue. Type instructions, or Stop."
        choices="Stop,Full auto,Auto mode,Keep going"
      fi
      if ! answer=$(jarvis-discord ask -choices "$choices" "$msg

$q"); then
        echo "==> couldn't reach Discord; retrying in 5 minutes"
        sleep 300
        continue
      fi

      shopt -s nocasematch
      case "$answer" in
        stop)    shopt -u nocasematch
                 notify "Stopped. Run agent-run as $(whoami) on $(hostname) to pick it up again."
                 exit 0 ;;
        skip)    shopt -u nocasematch
                 [[ -n "$job_id" ]] && jarvis-jobs skip "$job_id"
                 msg="Skipped ${job_id:-nothing}."
                 continue ;;
        sonnet)  d=sonnet; note="" ;;
        "igpu model"|igpu) d=igpu; note="" ;;
        "local model"|local) d=local; note="" ;;
        "super agent"|superagent) d=superagent; note="" ;;
        "full auto")  shopt -u nocasematch
                 # NoBrakes button: turn the switch on and go back to the top
                 # of the loop — the next iteration re-reads the flag and
                 # runs the next ready job without asking. A set that cannot
                 # reach Redis is reported, never swallowed: the owner must
                 # not believe a flipped switch is on.
                 if jarvis-jobs fullauto on >/dev/null; then
                   msg="Full auto is on — each ready job runs immediately, at any time of day (stop: !fullauto off)."
                 else
                   msg="Couldn't turn on full auto — the NoBrakes flag store (Redis) is unreachable; the switch is unchanged."
                 fi
                 notify "$msg"
                 continue ;;
        "auto mode")  shopt -u nocasematch
                 if jarvis-jobs automode on >/dev/null; then
                   msg="Auto mode is on — nightly-tagged jobs auto-enqueue at the top of each loop iteration, once per UTC day (stop: !automode off)."
                 else
                   msg="Couldn't turn on auto mode — the NoBrakes flag store (Redis) is unreachable; the switch is unchanged."
                 fi
                 notify "$msg"
                 continue ;;
        "keep going") shopt -u nocasematch
                 if jarvis-jobs keepgoing on >/dev/null; then
                   msg="Keep going is on — if an auto job fails, I'll tell you but keep working through the next ready job instead of pausing (stop: !keepgoing off)."
                 else
                   msg="Couldn't turn on keep going — the NoBrakes flag store (Redis) is unreachable; the switch is unchanged."
                 fi
                 notify "$msg"
                 continue ;;
        *)       d=local; note="$answer" ;;
      esac
      shopt -u nocasematch
      # The spec driver is only authoritative in full-auto; when a supervised
      # dispatch diverges from it, say so — moe-bench-250 was specced for
      # sonnet but ran on local and stopped its own brain (2026-11-04).
      if [[ -n "$job_id" ]]; then
        specd=$(jarvis-jobs show "$job_id" 2>/dev/null | sed -n 's/^driver: //p')
        if [[ "$specd" =~ ^(local|igpu|sonnet|superagent)$ && "$specd" != "$d" ]]; then
          notify "Note: ${job_title} is specced for the $specd driver, but this round runs on $d."
        fi
      fi
    fi
  fi

  if [[ -z "$job_id" ]]; then
    msg="No job to run, and typed instructions need a queued job. Add one with jarvis-enqueue or the migration script."
    continue
  fi

  # Photo window, first run: the pulled job is photo-tagged, so it runs
  # with the brain out of the 4090 (art+bench hold the VRAM; the photo
  # itself runs as code — the jarvis-photo executor, no model round).
  # Open the window for the whole ready batch first; if one is already
  # open (the loop's or a manual one), re-flip the batch so it keeps
  # front-of-band priority and the maintenance window extends as long as
  # there is work.
  if is_photo_job "$job_id"; then
    ids=$(photo_batch); [[ -n "$ids" ]] || ids="$job_id"
    if swap_window_open; then
      # Best-effort: even if the flip fails the job can still run (art is
      # up) — swap.log has the why.
      if jarvis-swap out --jobs "$ids" --force \
          --reason "photo batch re-flip (queue watcher)"; then
        echo "$(date '+%F %T') batch: ${ids//,/ }" > "$CONF/photo-window"
        photo_swap_warn=0
      fi
    elif jarvis-swap out --jobs "$ids" --force \
        --reason "queue watcher: photo batch ${ids//,/ }"; then
      echo "$(date '+%F %T') batch: ${ids//,/ }" > "$CONF/photo-window"
      photo_swap_warn=0
    else
      # The window wouldn't open (e.g. brain down without a maintenance
      # window — the 2026-11-04 failure mode the watchdog owns). Back off
      # so the watchdog can re-arm the brain; notify once per failure
      # stretch, not once per retry.
      if (( photo_swap_warn == 0 )); then
        notify "Photo job ${job_id} is next but the swap window wouldn't open (see swap.log) — retrying in 60 s."
        photo_swap_warn=1
      fi
      sleep 60
      continue
    fi
    # The brain is (or just got) out: the photo runs as code (jarvis-photo),
    # not a model round — the driver label is vestigial for photo jobs.
    d=igpu
  fi

  echo "$d" > "$DRIVER"
  echo "$job_id" > "$CONF/current-job"
  round=$((round + 1))
  echo "==> $(date '+%F %T') job $job_id on $d (round $round)"

  # A !restart or a Stop sent between rounds must not kill the new round on
  # start.
  rm -f "$CONF/restart-signal"
  rm -f "$CONF/stop-signal"

  # Start Discord watcher so the user can interrupt this job at any time.
  start_watcher
  # NoBrakes 6/6: a full-auto round runs under the auto-execution guard
  # (-auto: take the nobrakes:running marker — at most one concurrent
  # auto job — released when the round ends). A supervised round never
  # touches the marker: manual runs are the operator's override.
  if (( auto_run )); then
    jarvis-jobs run "$job_id" -driver "$d" -round "$(date +%s)-$round" -note "$note" -auto; status=$?
    # Exit 3 = another auto job holds the marker. Never run a second
    # one: idle-poll and retry next iteration (the holder's round
    # releases the marker when it ends; a stale one is taken over
    # automatically).
    if (( status == 3 )); then
      echo "==> another auto job is running; idle-polling"
      rm -f "$CONF/current-job"   # no round started — resume must not claim one
      stop_watcher
      sleep 60
      continue
    fi
  else
    jarvis-jobs run "$job_id" -driver "$d" -round "$(date +%s)-$round" -note "$note"; status=$?
  fi
  stop_watcher
  exit_if_rebooting   # keep current-job: agent-resume records it after the reboot

  # Check if the job was paused (user messaged during the run).
  job_status=$(jarvis-jobs list 2>/dev/null | awk -v id="$job_id" '$2 == id {print $1}')
  # NoBrakes 6/6: an auto round that failed pauses autonomous execution —
  # auto_mode and full_auto are set off and the owner is notified on
  # Discord (jarvis-jobs autopause). A supervised round never pauses the
  # feature: manual runs are the override, and a !pause / !restart is a
  # deliberate operator act, not a failure.
  #
  # Keep-going mode: when the keep_going flag is on, the failure path
  # notifies the owner but does NOT pause — the loop moves on to the next
  # ready job (jarvis-jobs failnote: no flag writes). The flag is read
  # fresh and fails safe to off, so Redis trouble still pauses.
  if (( auto_run )) && [[ "$job_status" == "failed" ]]; then
    if [[ "$(jarvis-jobs keepgoing 2>/dev/null || echo off)" == "on" ]]; then
      jarvis-jobs failnote "$job_id" || true
    else
      jarvis-jobs autopause "$job_id" || true
    fi
  fi
  if [[ "$job_status" == "paused" ]]; then
    rm -f "$CONF/current-job"
    # Read the user's message from the signal file.
    user_msg=""
    if [[ -f "$CONF/pause-signal" ]]; then
      user_msg=$(cat "$CONF/pause-signal")
      rm -f "$CONF/pause-signal"
    fi
    # Answer the user directly, then put the job back in the queue.
    # jarvis-reply sends one short chat call pinned to the reserved chat
    # slot (the work slot keeps running) and DMs the answer via
    # jarvis-discord. If the brain is busy past the 2-minute limit it says
    # "I'm busy on <job>, I'll answer after it" and we go on.
    jarvis-reply --job "$job_id" "$user_msg" || true
    jarvis-jobs requeue "$job_id"
    msg="You interrupted the job to talk. What's next?"
    continue
  fi

  rm -f "$CONF/current-job"
  # A !restart during the run re-queued the job for a fresh conversation.
  if [[ "$job_status" == "ready" ]]; then
    msg="!restart: ${job_id} is back in the queue — it runs next in a fresh conversation."
  else
    msg=$(summary "$d" "$status")
  fi
done
