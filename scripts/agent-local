#!/usr/bin/env bash
#
# agent-local: run Claude Code on the local Ollama model instead of the
# Anthropic API. Same tools, same brief, same jarvis-discord/agent-reboot
# helpers; only the model behind it changes.
#
#   agent-local [claude args...]   e.g. agent-local -p "hello"
#   agent-local check              prove the local model can drive Claude
#                                  Code's tools (exit 0 = it can)
#
# Reads $CONF/local.env, written by the stage-2 (Sonnet) setup run:
#   LOCAL_MODEL        Ollama model that makes decisions (the "brain")
#   LOCAL_CODER_MODEL  Ollama model for bulk coding; empty = same as brain
#   OLLAMA_URL         default http://localhost:11434
#   ENGINE_URL         when set, overrides OLLAMA_URL (llama.cpp engine)
#
# LOCAL_MODEL, ENGINE_URL and LOCAL_CONTEXT_TOKENS may also be pre-set in
# the environment — the igpu driver does this to point a round at the
# small iGPU model. Pre-set values win over local.env.
#
# When the coder differs from the brain, a "coder" subagent is defined
# that runs on it. Claude Code subagents pick models by tier alias, so the
# sonnet/opus tiers are mapped to the coder and haiku (quick background
# calls) to the brain. Nothing here talks to the Anthropic API.

set -euo pipefail

CONF="${JARVIS_CONF:-$HOME/.config/jarvis}"
[[ -r "$CONF/local.env" ]] || { echo "agent-local: $CONF/local.env not found (stage 2 writes it)" >&2; exit 1; }
# A driver (e.g. igpu) can pre-set these; they win over local.env.
_ovr_local_model="${LOCAL_MODEL-}"
_ovr_engine_url="${ENGINE_URL-}"
_ovr_ctx_tokens="${LOCAL_CONTEXT_TOKENS-}"
# shellcheck disable=SC1091
source "$CONF/local.env"
[[ -n "$_ovr_local_model" ]] && LOCAL_MODEL="$_ovr_local_model"
[[ -n "$_ovr_engine_url" ]] && ENGINE_URL="$_ovr_engine_url"
[[ -n "$_ovr_ctx_tokens" ]] && LOCAL_CONTEXT_TOKENS="$_ovr_ctx_tokens"
[[ -n "${LOCAL_MODEL:-}" ]] || { echo "agent-local: LOCAL_MODEL not set in $CONF/local.env" >&2; exit 1; }
CODER="${LOCAL_CODER_MODEL:-$LOCAL_MODEL}"

if [[ "${1:-}" == "check" ]]; then
  dir=$(mktemp -d)
  token="jarvis-$RANDOM$RANDOM"
  echo "==> asking $LOCAL_MODEL to write $token to $dir/proof.txt via the Bash tool"
  ( cd "$dir" && timeout 900 "$(readlink -f "$0")" --dangerously-skip-permissions -p \
      "Use the Bash tool to run exactly this command: echo $token > proof.txt
Then reply with just the word done." ) || true
  if [[ "$(cat "$dir/proof.txt" 2>/dev/null)" == "$token" ]]; then
    echo "==> OK: $LOCAL_MODEL can drive Claude Code"
    rm -rf "$dir"
    exit 0
  fi
  echo "==> FAILED: no proof file written (left $dir for inspection)" >&2
  exit 1
fi

unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL="${ENGINE_URL:-${OLLAMA_URL:-http://localhost:11434}}"
export ANTHROPIC_AUTH_TOKEN=ollama
# Match live jarvis-engine --ctx-size 131072 (128k). Override with LOCAL_CONTEXT_TOKENS / LOCAL_OUTPUT_TOKENS.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${LOCAL_CONTEXT_TOKENS:-131072}"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${LOCAL_OUTPUT_TOKENS:-${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-262144}}"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-${LOCAL_CONTEXT_TOKENS:-131072}}"
# jarvis-brain is not an Anthropic ID; skip SDK model-name validation (telemetry: unrecognized_model).
export ANTHROPIC_CUSTOM_MODEL_OPTION="${ANTHROPIC_CUSTOM_MODEL_OPTION:-$LOCAL_MODEL}"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="${ANTHROPIC_CUSTOM_MODEL_OPTION_NAME:-$LOCAL_MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$LOCAL_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$CODER"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$CODER"

# Claude Code 2.1 flag is --effort, not --reasoning-effort (that errors:
# "unknown option '--reasoning-effort'"). SDK "unknown" is not a valid level.
canon_effort() {
  local r="${1,,}"
  case "$r" in
    off|false|none|no|0) echo off ;;
    low) echo low ;;
    medium) echo medium ;;
    high|xhigh|max) echo xhigh ;;
    unknown|auto|"") echo medium ;;
    *) echo medium ;;
  esac
}

effort="${CLAUDE_CODE_EFFORT_LEVEL:-}"
pass=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --reasoning-effort|--effort)
      [[ $# -ge 2 ]] || { echo "agent-local: $1 needs a value" >&2; exit 2; }
      effort="$2"; shift 2 ;;
    --reasoning-effort=*|--effort=*)
      effort="${1#*=}"; shift ;;
    *)
      pass+=("$1"); shift ;;
  esac
done
effort="$(canon_effort "$effort")"

args=(--model "$LOCAL_MODEL")
if [[ "$CODER" != "$LOCAL_MODEL" ]]; then
  args+=(--agents "$(jq -nc --arg m "$CODER" '{coder: {
    description: "Writes and edits code for a well-specified task (\($m)). Use it for bulk or boilerplate coding; give it the files, the goal and how to test.",
    prompt: "You are the coding model. Do exactly the coding task you are given, run the relevant build/tests, and report what you changed and the test result. Do not commit, push, or message anyone.",
    model: "sonnet"}}')")
fi
if [[ "$effort" == off ]]; then
  export CLAUDE_CODE_DISABLE_THINKING=1
  export MAX_THINKING_TOKENS=0
  unset CLAUDE_CODE_EFFORT_LEVEL || true
else
  export CLAUDE_CODE_EFFORT_LEVEL="$effort"
  args+=(--effort "$effort")
fi
exec claude "${args[@]}" "${pass[@]}"
